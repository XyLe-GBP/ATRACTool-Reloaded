<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>ATRACTool_Reloaded</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.53.2620.913</AssemblyVersion>
    <FileVersion>1.53.2620.913</FileVersion>
    <Version>$(FileVersion)</Version>
    <InformationalVersion>$(FileVersion)</InformationalVersion>
    <AssemblyTitle>ATRACTool Reloaded</AssemblyTitle>
    <Product>ATRACTool Reloaded</Product>
    <Authors>XyLe</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/XyLe-GBP/ATRACTool-Reloaded</RepositoryUrl>
    <PackageProjectUrl>https://github.com/XyLe-GBP/ATRACTool-Reloaded</PackageProjectUrl>
    <Company>XyLe</Company>
    <Description>Open source ATRAC conversion utility</Description>
    <Copyright>Copyright © 2026 - XyLe. All Rights Reserved.</Copyright>
    <PackageTags>ATRAC, ATRAC1, ATRAC3, ATRAC9, MiniDisc, walkman, aea, at3, at9, Converter, GUI</PackageTags>
    <ApplicationIcon>Properties\ATRACTool.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <UseWPF>True</UseWPF>
    <CodeSignToolPath Condition="'$(CodeSignToolPath)' == ''">signtool.exe</CodeSignToolPath>
    <CodeSignTimestampUrl Condition="'$(CodeSignTimestampUrl)' == ''">http://timestamp.digicert.com</CodeSignTimestampUrl>
    <CodeSignDescription Condition="'$(CodeSignDescription)' == ''">ATRACTool Reloaded</CodeSignDescription>
    <CodeSignDescriptionUrl Condition="'$(CodeSignDescriptionUrl)' == ''">https://github.com/XyLe-GBP/ATRACTool-Reloaded</CodeSignDescriptionUrl>
    <CodeSignCertificatePasswordArgument Condition="'$(CodeSignCertificatePassword)' != ''">/p "$(CodeSignCertificatePassword)"</CodeSignCertificatePasswordArgument>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ApplicationUpdater\**" />
    <EmbeddedResource Remove="ApplicationUpdater\**" />
    <None Remove="ApplicationUpdater\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Properties\IMG_1540.JPG" />
    <None Remove="Properties\SIE_White.png" />
    <None Remove="src\Forms\ATRACTool.ico" />
    <None Remove="src\Forms\IMG_1540.JPG" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\ATRACTool.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediaToolkit" Version="1.1.0.1" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\IMG_1540.JPG">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Properties\SIE.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Properties\SIE_Default.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Properties\SIE_White.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="third_party\atracdenc\0.2.3\win-x86\atracdenc.exe">
      <TargetPath>res\atracdenc.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="third_party\atracdenc\0.2.3\win-x86\README.TXT">
      <TargetPath>res\licenses\atracdenc\README.TXT</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="third_party\atracdenc\0.2.3\win-x86\LICENSE">
      <TargetPath>res\licenses\atracdenc\LICENSE</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="third_party\atracdenc\0.2.3\win-x86\NOTICE.md">
      <TargetPath>res\licenses\atracdenc\NOTICE.md</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Localizable\localization.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Localization.resx</DependentUpon>
    </Compile>
    <Compile Update="Localizable\XAMLWindowLocalization.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>XAMLWindowLocalization.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="src\Forms\FormWalkmanInformations.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localizable\Localization.ja.resx">
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizable\Localization.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>localization.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localizable\XAMLWindowLocalization.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>XAMLWindowLocalization.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="SignPublishedExecutablesFromStore" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(CodeSignCertificateThumbprint)' != '' and '$(CodeSignCertificateFile)' == ''">
    <ItemGroup>
      <PublishedExecutableToSign Include="$(PublishDir)ATRACTool-Reloaded.exe" Condition="Exists('$(PublishDir)ATRACTool-Reloaded.exe')" />
      <PublishedExecutableToSign Include="$(PublishDir)res\updater.exe" Condition="Exists('$(PublishDir)res\updater.exe')" />
    </ItemGroup>
    <Message Importance="High" Text="Signing published executable: %(PublishedExecutableToSign.Identity)" Condition="'@(PublishedExecutableToSign)' != ''" />
    <Exec Condition="'@(PublishedExecutableToSign)' != ''" Command="&quot;$(CodeSignToolPath)&quot; sign /sha1 &quot;$(CodeSignCertificateThumbprint)&quot; /fd SHA256 /tr &quot;$(CodeSignTimestampUrl)&quot; /td SHA256 /d &quot;$(CodeSignDescription)&quot; /du &quot;$(CodeSignDescriptionUrl)&quot; &quot;%(PublishedExecutableToSign.Identity)&quot;" />
    <Exec Condition="'@(PublishedExecutableToSign)' != ''" Command="&quot;$(CodeSignToolPath)&quot; verify /pa /tw &quot;%(PublishedExecutableToSign.Identity)&quot;" />
  </Target>

  <Target Name="SignPublishedExecutablesFromPfx" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(CodeSignCertificateFile)' != ''">
    <ItemGroup>
      <PublishedExecutableToSign Include="$(PublishDir)ATRACTool-Reloaded.exe" Condition="Exists('$(PublishDir)ATRACTool-Reloaded.exe')" />
      <PublishedExecutableToSign Include="$(PublishDir)res\updater.exe" Condition="Exists('$(PublishDir)res\updater.exe')" />
    </ItemGroup>
    <Message Importance="High" Text="Signing published executable: %(PublishedExecutableToSign.Identity)" Condition="'@(PublishedExecutableToSign)' != ''" />
    <Exec Condition="'@(PublishedExecutableToSign)' != ''" Command="&quot;$(CodeSignToolPath)&quot; sign /f &quot;$(CodeSignCertificateFile)&quot; $(CodeSignCertificatePasswordArgument) /fd SHA256 /tr &quot;$(CodeSignTimestampUrl)&quot; /td SHA256 /d &quot;$(CodeSignDescription)&quot; /du &quot;$(CodeSignDescriptionUrl)&quot; &quot;%(PublishedExecutableToSign.Identity)&quot;" />
    <Exec Condition="'@(PublishedExecutableToSign)' != ''" Command="&quot;$(CodeSignToolPath)&quot; verify /pa /tw &quot;%(PublishedExecutableToSign.Identity)&quot;" />
  </Target>

  <Target Name="ReportUnsignedPublishedExecutables" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(CodeSignCertificateThumbprint)' == '' and '$(CodeSignCertificateFile)' == ''">
    <ItemGroup>
      <UnsignedPublishedExecutable Include="$(PublishDir)ATRACTool-Reloaded.exe" Condition="Exists('$(PublishDir)ATRACTool-Reloaded.exe')" />
      <UnsignedPublishedExecutable Include="$(PublishDir)res\updater.exe" Condition="Exists('$(PublishDir)res\updater.exe')" />
    </ItemGroup>
    <Message Importance="High" Text="Published executable is unsigned: %(UnsignedPublishedExecutable.Identity). Set CodeSignCertificateThumbprint or CodeSignCertificateFile to reduce Norton/SmartScreen reputation warnings." Condition="'@(UnsignedPublishedExecutable)' != ''" />
  </Target>

</Project>
