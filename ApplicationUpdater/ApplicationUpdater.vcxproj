  <Target Name="SignApplicationUpdaterFromStore" AfterTargets="Link" Condition="'$(Configuration)'=='Release' and '$(CodeSignCertificateThumbprint)'!='' and '$(CodeSignCertificateFile)'==''">
    <Message Importance="High" Text="Signing $(TargetPath) with certificate thumbprint $(CodeSignCertificateThumbprint)." />
    <Exec Command="&quot;$(CodeSignToolPath)&quot; sign /sha1 &quot;$(CodeSignCertificateThumbprint)&quot; /fd SHA256 /tr &quot;$(CodeSignTimestampUrl)&quot; /td SHA256 /d &quot;$(CodeSignDescription)&quot; /du &quot;$(CodeSignDescriptionUrl)&quot; &quot;$(TargetPath)&quot;" />
    <Exec Command="&quot;$(CodeSignToolPath)&quot; verify /pa /tw &quot;$(TargetPath)&quot;" />
  </Target>
  <Target Name="SignApplicationUpdaterFromPfx" AfterTargets="Link" Condition="'$(Configuration)'=='Release' and '$(CodeSignCertificateFile)'!=''">
    <Message Importance="High" Text="Signing $(TargetPath) with certificate file $(CodeSignCertificateFile)." />
    <Exec Command="&quot;$(CodeSignToolPath)&quot; sign /f &quot;$(CodeSignCertificateFile)&quot; $(CodeSignCertificatePasswordArgument) /fd SHA256 /tr &quot;$(CodeSignTimestampUrl)&quot; /td SHA256 /d &quot;$(CodeSignDescription)&quot; /du &quot;$(CodeSignDescriptionUrl)&quot; &quot;$(TargetPath)&quot;" />
    <Exec Command="&quot;$(CodeSignToolPath)&quot; verify /pa /tw &quot;$(TargetPath)&quot;" />
  </Target>
  <Target Name="ReportUnsignedApplicationUpdater" AfterTargets="Link" Condition="'$(Configuration)'=='Release' and '$(CodeSignCertificateThumbprint)'=='' and '$(CodeSignCertificateFile)'==''">
    <Message Importance="High" Text="ApplicationUpdater was built unsigned. Set CodeSignCertificateThumbprint or CodeSignCertificateFile to Authenticode-sign updater.exe." />
  </Target>
